{
  "version": 1,
  "syscalls": {
    "process.create": { "capability": "process.spawn", "schema": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "maxLength": 128 }, "type": { "type": "string", "enum": ["task", "application", "service", "worker"] }, "parentPid": { "type": ["integer", "null"] }, "args": { "type": "array", "maxItems": 256 }, "env": { "type": "object" }, "capabilities": { "type": "array", "items": { "type": "string" } }, "priority": { "type": "integer", "minimum": -20, "maximum": 20 }, "resourceLimits": { "type": "object" } } } },
    "process.spawn": { "capability": "process.spawn", "schema": { "type": "object", "additionalProperties": false, "required": ["executable"], "properties": { "executable": { "type": "string", "minLength": 1, "maxLength": 4096 }, "args": { "type": "array", "maxItems": 256 }, "env": { "type": "object" }, "capabilities": { "type": "array", "items": { "type": "string" } }, "priority": { "type": "integer", "minimum": -20, "maximum": 20 } } } },
    "process.exit": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["pid"], "properties": { "pid": { "type": "integer", "minimum": 100 }, "exitCode": { "type": "integer" } } } },
    "process.signal": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["pid", "signal"], "properties": { "pid": { "type": "integer", "minimum": 100 }, "signal": { "type": "string", "enum": ["terminate", "kill", "interrupt", "suspend", "resume"] } } } },
    "process.wait": { "capability": "dynamic", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "required": ["pid"], "properties": { "pid": { "type": "integer", "minimum": 100 }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 } } } },
    "process.list": { "capability": "process.manage", "schema": { "type": "object", "additionalProperties": false, "properties": { "state": { "type": "string" }, "type": { "type": "string" }, "parentPid": { "type": "integer" } } } },
    "process.get": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["pid"], "properties": { "pid": { "type": "integer", "minimum": 100 } } } },
    "process.suspend": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["pid"], "properties": { "pid": { "type": "integer", "minimum": 100 } } } },
    "process.resume": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["pid"], "properties": { "pid": { "type": "integer", "minimum": 100 } } } },

    "fs.open": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "mode": { "type": "string", "enum": ["read", "write", "readwrite", "append"] }, "create": { "type": "boolean" }, "truncate": { "type": "boolean" } } } },
    "fs.close": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["fd"], "properties": { "fd": { "type": "integer", "minimum": 3 } } } },
    "fs.read": { "capability": "dynamic", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "properties": { "fd": { "type": "integer", "minimum": 3 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "length": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "offset": { "type": "integer", "minimum": 0 }, "encoding": { "type": "string", "enum": ["bytes", "text", "base64"] } } } },
    "fs.write": { "capability": "dynamic", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "required": ["data"], "properties": { "fd": { "type": "integer", "minimum": 3 }, "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "data": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "maxItems": 33554432 }, { "type": "object" }] }, "offset": { "type": "integer", "minimum": 0 }, "create": { "type": "boolean" }, "encoding": { "type": "string", "enum": ["text", "base64"] } } } },
    "fs.stat": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 } } } },
    "fs.readdir": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 } } } },
    "fs.mkdir": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "recursive": { "type": "boolean" }, "mode": { "type": ["integer", "string"] } } } },
    "fs.unlink": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "recursive": { "type": "boolean" } } } },
    "fs.rename": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "minLength": 1, "maxLength": 4096 }, "to": { "type": "string", "minLength": 1, "maxLength": 4096 } } } },
    "fs.copy": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "minLength": 1, "maxLength": 4096 }, "to": { "type": "string", "minLength": 1, "maxLength": 4096 } } } },
    "fs.resolve": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 } } } },
    "fs.realpath": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 } } } },
    "fs.access": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "mode": { "type": "string", "enum": ["read", "write", "readwrite", "execute"] } } } },
    "fs.chmod": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["path", "mode"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "mode": { "type": ["integer", "string"] }, "owner": { "type": "string" } } } },
    "fs.mount": { "capability": "storage.write", "schema": { "type": "object", "additionalProperties": false, "required": ["diskId", "mountPoint"], "properties": { "diskId": { "type": "string" }, "mountPoint": { "type": "string", "minLength": 1, "maxLength": 4096 }, "readOnly": { "type": "boolean" } } } },
    "fs.unmount": { "capability": "storage.write", "schema": { "type": "object", "additionalProperties": false, "required": ["diskId"], "properties": { "diskId": { "type": "string" }, "force": { "type": "boolean" } } } },

    "memory.allocate": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["bytes"], "properties": { "bytes": { "type": "integer", "minimum": 0 }, "label": { "type": "string" } } } },
    "memory.release": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["leaseId"], "properties": { "leaseId": { "type": "string" } } } },
    "resource.get": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "properties": { "resource": { "type": "string" } } } },
    "resource.limit": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["resource", "value"], "properties": { "resource": { "type": "string" }, "value": { "type": "integer", "minimum": 0 }, "pid": { "type": "integer", "minimum": 100 } } } },
    "resource.usage": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "properties": { "pid": { "type": "integer", "minimum": 100 } } } },

    "ipc.create": { "capability": "ipc.use", "schema": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "maxLength": 128 }, "scope": { "type": "string", "enum": ["process", "shared", "system"] }, "readers": { "type": "array", "items": { "type": "string" } }, "writers": { "type": "array", "items": { "type": "string" } }, "capacity": { "type": "integer", "minimum": 1, "maximum": 1000 } } } },
    "ipc.send": { "capability": "ipc.use", "schema": { "type": "object", "additionalProperties": false, "required": ["channelId", "message"], "properties": { "channelId": { "type": "string" }, "message": {} } } },
    "ipc.receive": { "capability": "ipc.use", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "required": ["channelId"], "properties": { "channelId": { "type": "string" }, "subscriptionId": { "type": "string" }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 } } } },
    "ipc.subscribe": { "capability": "ipc.use", "schema": { "type": "object", "additionalProperties": false, "required": ["channelId"], "properties": { "channelId": { "type": "string" } } } },
    "ipc.unsubscribe": { "capability": "ipc.use", "schema": { "type": "object", "additionalProperties": false, "required": ["channelId", "subscriptionId"], "properties": { "channelId": { "type": "string" }, "subscriptionId": { "type": "string" } } } },
    "ipc.close": { "capability": "ipc.use", "schema": { "type": "object", "additionalProperties": false, "required": ["channelId"], "properties": { "channelId": { "type": "string" } } } },

    "service.register": { "capability": "service.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["definition"], "properties": { "definition": { "type": "object" } } } },
    "service.start": { "capability": "service.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" } } } },
    "service.stop": { "capability": "service.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" } } } },
    "service.restart": { "capability": "service.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" } } } },
    "service.status": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" } } } },
    "service.list": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false, "properties": { "state": { "type": "string" } } } },
    "service.logs": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000 } } } },

    "package.install": { "capability": "package.install", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "properties": { "archive": { "type": "object" },  "source": { "type": "string", "enum": ["local", "repository"] }, "repositoryId": { "type": "string" }, "packageId": { "type": "string" }, "allowUnsignedLocal": { "type": "boolean" } } } },
    "package.remove": { "capability": "package.remove", "schema": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string" }, "cascade": { "type": "boolean" } } } },
    "package.update": { "capability": "package.install", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" } } } },
    "package.query": { "capability": "package.query", "schema": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string" } } } },
    "package.list": { "capability": "package.query", "schema": { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string" } } } },
    "app.launch": { "capability": "process.spawn", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string" }, "args": { "type": "array", "maxItems": 256 }, "env": { "type": "object" }, "priority": { "type": "integer", "minimum": -20, "maximum": 20 } } } },
    "app.terminate": { "capability": "process.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["pid"], "properties": { "pid": { "type": "integer", "minimum": 100 } } } },
    "app.list": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" } } } },

    "system.info": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false } },
    "system.status": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false } },
    "system.shutdown": { "capability": "system.control", "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500 } } } },
    "system.reboot": { "capability": "system.control", "schema": { "type": "object", "additionalProperties": false } },
    "config.get": { "capability": "system.config", "schema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "enum": ["system", "security", "repositories", "mounts"] } } } },
    "config.update": { "capability": "system.config", "schema": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string", "enum": ["system", "security", "repositories", "mounts"] }, "value": { "type": "object" } } } },
    "config.reload": { "capability": "system.config", "schema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "enum": ["system", "security", "repositories", "mounts"] } } } },
    "config.list": { "capability": "system.config", "schema": { "type": "object", "additionalProperties": false } },
    "security.check": { "capability": "dynamic", "schema": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["capability"], "properties": { "capability": { "type": "string", "minLength": 1 } } }, { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "operation": { "type": "string", "enum": ["read", "write", "create", "delete", "rename", "chmod", "mount"] } } } ] } },
    "security.requestCapability": { "capability": "security.requestCapability", "schema": { "type": "object", "additionalProperties": false, "required": ["capability"], "properties": { "capability": { "type": "string" }, "reason": { "type": "string", "maxLength": 500 } } } },
    "security.audit": { "capability": "security.audit", "schema": { "type": "object", "additionalProperties": false, "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }, "principal": { "type": "string" }, "outcome": { "type": "string" } } } },
    "network.request": { "capability": "network.fetch", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "type": "string", "minLength": 1, "maxLength": 8192 }, "method": { "type": "string" }, "headers": { "type": "object" }, "body": { "type": ["string", "object"] }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }, "cache": { "type": "string", "enum": ["default", "no-store", "reload", "force-cache"] }, "responseType": { "type": "string", "enum": ["bytes", "text"] } } } },
    "device.list": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false } },
    "disk.list": { "capability": "storage.read", "schema": { "type": "object", "additionalProperties": false } },
    "repository.list": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false } },
    "repository.query": { "capability": "package.query", "schema": { "type": "object", "additionalProperties": false, "required": ["packageId"], "properties": { "packageId": { "type": "string" }, "range": { "type": "string" } } } },
    "repository.refresh": { "capability": "network.fetch", "cancellable": true, "schema": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" } } } },
    "repository.local.create": { "capability": "repository.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
    "repository.local.publish": { "capability": "repository.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["repositoryId", "archive"], "properties": { "repositoryId": { "type": "string" }, "archive": { "type": "object" } } } },
    "repository.local.remove": { "capability": "repository.manage", "schema": { "type": "object", "additionalProperties": false, "required": ["repositoryId", "packageId", "version"], "properties": { "repositoryId": { "type": "string" }, "packageId": { "type": "string" }, "version": { "type": "string" } } } },
    "disk.create": { "capability": "storage.write", "schema": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "id": { "type": "string" }, "type": { "type": "string", "enum": ["indexeddb", "memory", "opfs", "remote", "static"] }, "label": { "type": "string" }, "quota": { "type": "integer", "minimum": 0 }, "mountPoint": { "type": "string" }, "readOnly": { "type": "boolean" }, "remote": { "type": "object" } } } },
    "disk.authorizeDirectory": { "capability": "storage.write", "schema": { "type": "object", "additionalProperties": false, "required": ["handle"], "properties": { "id": { "type": "string" }, "handle": { "type": "object" }, "mountPoint": { "type": "string" }, "readOnly": { "type": "boolean" } } } },
    "log.query": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false, "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }, "since": { "type": "string" }, "severity": { "type": "string" }, "subsystem": { "type": "string" }, "identity": { "type": "string" } } } },
    "log.write": { "capability": "dynamic", "schema": { "type": "object", "additionalProperties": false, "required": ["severity", "subsystem", "message"], "properties": { "severity": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "fatal"] }, "subsystem": { "type": "string", "maxLength": 128 }, "message": { "type": "string", "maxLength": 8192 }, "metadata": { "type": "object" } } } },
    "syscall.list": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false } },
    "diagnostics.run": { "capability": "system.info", "schema": { "type": "object", "additionalProperties": false } }
  }
}
